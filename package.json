{
  "name": "handbrake-output-size-predictor",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main/main.js",
  "type": "module",
  "description": "Local HandBrake output size estimator for average-bitrate and CRF predictions.",
  "author": "ThePsychof",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "wait-on tcp:5173 && electron .",
    "build": "rimraf dist dist-electron && tsc -p tsconfig.main.json && vite build && electron-builder --dir --config.directories.output=build-output",
    "package": "rimraf dist dist-electron release && tsc -p tsconfig.main.json && vite build && electron-builder",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.4",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.handbrake.outputsizepredictor",
    "productName": "HandBrake FinalSIzeCalculator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
